# PostgreSQL / Neon
DATABASE_URL=postgresql://usuario:senha@host:5432/biotrop?sslmode=require
DATABASE_SSL=true

# Sessão da aplicação (mínimo 32 caracteres)
SESSION_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Login corporativo Microsoft Entra ID
LOGIN_LOCAL_ATIVO=false
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=coloque-o-segredo-aqui
APP_BASE_URL=https://v3-base.vercel.app

# Produção / rede interna
# Nunca commite valores reais neste arquivo.
