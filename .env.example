# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/biotrop
DATABASE_SSL=true

# Sessão da aplicação (mínimo 32 caracteres)
SESSION_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Mantém o login e-mail/senha existente como fallback.
# Em produção corporativa, você pode mudar para false depois de validar o Microsoft.
LOGIN_LOCAL_ATIVO=true

# Microsoft Entra ID — App Registration "Biotrop Manutencao - Web"
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=coloque-o-segredo-aqui
APP_BASE_URL=https://v3-base.vercel.app
