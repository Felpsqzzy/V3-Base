# /etc/systemd/system/biotrop-email.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now biotrop-email
#   sudo journalctl -u biotrop-email -f
#
# Restart=always com RestartSec: se o Graph ou o banco cair, o worker
# volta sozinho em vez de exigir alguem de plantao.

[Unit]
Description=BIOTROP - worker da fila de e-mail (Microsoft Graph)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=biotrop
WorkingDirectory=/opt/biotrop/servidor-email
EnvironmentFile=/opt/biotrop/servidor-email/.env
ExecStart=/usr/bin/node worker.js
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

# O worker so precisa de rede e do proprio diretorio.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/biotrop/servidor-email

[Install]
WantedBy=multi-user.target
